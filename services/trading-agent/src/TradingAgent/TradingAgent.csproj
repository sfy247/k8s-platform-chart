<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Web SDK: the agent is a background worker that also serves health
         endpoints, because Kubernetes probes are HTTP. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>ClaudeTradingAgent.TradingAgent</RootNamespace>
    <UserSecretsId>claude-trading-agent</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Strategy/Strategy.csproj" />
    <ProjectReference Include="../RiskManagement/RiskManagement.csproj" />
    <ProjectReference Include="../Execution/Execution.csproj" />
    <ProjectReference Include="../MarketData/MarketData.csproj" />
    <ProjectReference Include="../Portfolio/Portfolio.csproj" />
    <ProjectReference Include="../Persistence/Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>

</Project>
