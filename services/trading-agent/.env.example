# PAPER ONLY. Do not place real credentials in this file.
TRADING_MODE=PAPER
TRADING_ENABLED=false

ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_API_KEY_ID=replace-with-paper-key
ALPACA_API_SECRET_KEY=replace-with-paper-secret

TRADING_CONFIG_PATH=config/trading.json
SYMBOL_CONFIG_PATH=config/symbols.json

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=trading_app
POSTGRES_PASSWORD=replace-me

LOG_LEVEL=Information
