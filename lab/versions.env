# ─────────────────────────────────────────────────────────────
# Pinned toolchain + platform versions for the local lab.
# Every version below was resolved against upstream on 2026-08-22.
# Bump deliberately: change here, re-run `make lab-up`, verify.
# ─────────────────────────────────────────────────────────────

# CLI tooling installed by lab/scripts/preflight.sh into $LAB_BIN_DIR
K3D_VERSION="v5.9.0"
KUBECTL_VERSION="v1.36.4"
HELM_VERSION="v3.21.4"        # Helm 3.x, matching .github/workflows/lint-test.yaml

# Where preflight installs binaries (no sudo required)
LAB_BIN_DIR="${LAB_BIN_DIR:-$HOME/.local/bin}"

# Platform add-on chart versions
INGRESS_NGINX_CHART_VERSION="4.15.1"
ARGOCD_CHART_VERSION="10.4.0"

# Observability stack (in-cluster, namespace: observability)
KUBE_PROMETHEUS_STACK_CHART_VERSION="88.5.3"
LOKI_CHART_VERSION="7.3.0"
ALLOY_CHART_VERSION="1.11.1"

# Git source of truth that Argo CD reconciles from.
# Argo CD runs inside the cluster, so it reads from the REMOTE, not your
# working tree. Local edits deploy only after commit + push (or via `make deploy`).
REPO_URL="https://github.com/sfy247/k8s-platform-chart.git"
REPO_REVISION="main"

# Host ports published by the k3d load balancer (see lab/k3d/cluster.yaml).
# 8090/8543 rather than the usual 8080/8443: port 8080 on this machine is
# already published by another project's container. cluster-up.sh checks these
# before creating the cluster, so a collision fails fast instead of halfway.
LAB_HTTP_PORT="8090"
LAB_HTTPS_PORT="8543"

# Wildcard DNS that always resolves to loopback — no /etc/hosts edits needed.
LAB_DOMAIN="localtest.me"

# ─────────────────────────────────────────────────────────────
# Local image registry
# ─────────────────────────────────────────────────────────────
# A standalone container, deliberately NOT part of the cluster: `k3d cluster
# delete` does not touch it, so images built here survive a full rebuild and
# recovery becomes a pull rather than a rebuild from source.
#
# Images are addressed as localhost:5111/<name>:<tag> from both the host and
# the cluster — the host publishes that port, and the cluster mirrors it to
# the registry container over the k3d network (see lab/k3d/cluster.yaml).
REGISTRY_NAME="lab-registry"          # container becomes k3d-lab-registry
REGISTRY_PORT="5111"
REGISTRY_HOST="localhost:5111"        # what image references use
REGISTRY_VOLUME="k3d-lab-registry-data"
