    {
      "type": "timeseries",
      "title": "Node disk used (kubelet volume)",
      "description": "k3d nodes are containers, so there is no / mountpoint to graph \u2014 node-exporter reports the bind-mounted paths instead. /var/lib/kubelet is the one that matters: it holds pod storage and is what the kubelet's eviction manager watches. On k3d every node shares the Docker host's disk, so all three lines move together.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "1 - (node_filesystem_avail_bytes{mountpoint=\"/var/lib/kubelet\"} / node_filesystem_size_bytes{mountpoint=\"/var/lib/kubelet\"})",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Problems",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Pods not Running",
      "description": "Empty is good. Anything here is stuck Pending, Failed or Unknown.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
