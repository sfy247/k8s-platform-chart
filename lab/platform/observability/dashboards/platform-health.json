            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Sync failures (1h)",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "sum(increase(argocd_app_sync_total{phase!=\"Succeeded\"}[1h])) or vector(0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
