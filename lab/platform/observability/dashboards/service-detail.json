{
  "uid": "lab-service-detail",
  "title": "Service Detail",
  "description": "One service: who calls it, what it depends on, its traces and its logs. Opened by clicking a node on the Service Map.",
  "tags": [
    "lab",
    "platform",
    "traces"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "label": "Metrics source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "ds_tempo",
        "label": "Traces source",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "ds_loki",
        "label": "Logs source",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "query": {
          "query": "label_values(traces_service_graph_request_total, server)",
          "refId": "service"
        },
        "refresh": 1,
        "sort": 1,
        "current": {},
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "$service",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requests per second",
      "description": "Inbound, measured from spans.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "sum(rate(traces_service_graph_request_total{server=\"$service\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Error rate",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "100 * sum(rate(traces_service_graph_request_failed_total{server=\"$service\"}[$__rate_interval])) / clamp_min(sum(rate(traces_service_graph_request_total{server=\"$service\"}[$__rate_interval])), 0.00001)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_service_graph_request_server_seconds_bucket{server=\"$service\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Depends on",
      "description": "Services this one calls in the window.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "count(count by (server) (rate(traces_service_graph_request_total{client=\"$service\"}[$__rate_interval]) > 0))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Flow",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "nodeGraph",
      "title": "One hop around $service",
      "description": "Callers on the left, dependencies on the right. Click another node to walk the graph.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "sum by (id, title) (label_replace(label_replace(sum by (server) (rate(traces_service_graph_request_total{client=\"$service\", server!=\"$service\"}[$__range]) > 0), \"id\", \"$1\", \"server\", \"(.*)\"), \"title\", \"$1\", \"server\", \"(.*)\") or label_replace(label_replace(sum by (client) (rate(traces_service_graph_request_total{server=\"$service\", client!=\"$service\", client!=\"user\"}[$__range]) > 0), \"id\", \"$1\", \"client\", \"(.*)\"), \"title\", \"$1\", \"client\", \"(.*)\") or label_replace(label_replace(sum by (server) (rate(traces_service_graph_request_total{server=\"$service\"}[$__range]) > 0), \"id\", \"$1\", \"server\", \"(.*)\"), \"title\", \"$1\", \"server\", \"(.*)\"))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "label_join(label_replace(label_replace((sum by (client, server) (rate(traces_service_graph_request_total{client=\"$service\", server!=\"$service\"}[$__range]) > 0) or sum by (client, server) (rate(traces_service_graph_request_total{server=\"$service\", client!=\"$service\", client!=\"user\"}[$__range]) > 0)), \"source\", \"$1\", \"client\", \"(.*)\"), \"target\", \"$1\", \"server\", \"(.*)\"), \"id\", \" \u2192 \", \"source\", \"target\")",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "B",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "client": true,
              "server": true,
              "connection_type": true,
              "__metrics_gen_instance": true,
              "keep": true
            },
            "renameByName": {
              "Value": "mainstat"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__data.fields.id}",
                    "url": "/d/lab-service-detail/service-detail?var-service=${__data.fields.id}&from=${__from}&to=${__to}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "nodes": {
          "mainStatUnit": "req/s"
        },
        "edges": {
          "mainStatUnit": "req/s"
        }
      }
    },
    {
      "type": "table",
      "title": "Called by",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "sum by (client) (rate(traces_service_graph_request_total{server=\"$service\", client!=\"user\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "sum by (client) (rate(traces_service_graph_request_failed_total{server=\"$service\", client!=\"user\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (client, le) (rate(traces_service_graph_request_server_seconds_bucket{server=\"$service\", client!=\"user\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "client": "Service",
              "Value #A": "req/s",
              "Value #B": "errors/s",
              "Value #C": "p95 (s)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "Calls",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "sum by (server) (rate(traces_service_graph_request_total{client=\"$service\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "sum by (server) (rate(traces_service_graph_request_failed_total{client=\"$service\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (server, le) (rate(traces_service_graph_request_server_seconds_bucket{client=\"$service\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "server": "Service",
              "Value #A": "req/s",
              "Value #B": "errors/s",
              "Value #C": "p95 (s)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "row",
      "title": "Traces \u2014 the actual flow, hop by hop",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Recent traces through $service",
      "description": "Click a row to open the trace: every span in order, across every service and database it touched, with the time spent in each.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${ds_tempo}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\"}",
          "limit": 50,
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "row",
      "title": "Logs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "logs",
      "title": "Logs for $service",
      "description": "Matched on the app label Alloy sets from app.kubernetes.io/instance; a service whose eBPF name differs from that label will show nothing here.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "editorMode": "code",
          "expr": "{app=~\"$service.*\"} | line_format \"{{.severity}} {{.__line__}}\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": true
      }
    }
  ]
}
