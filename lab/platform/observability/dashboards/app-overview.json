        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "kube_deployment_status_replicas_ready{namespace=\"$namespace\", deployment=\"$app\"}",
          "legendFormat": "ready",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "editorMode": "code",
          "expr": "kube_deployment_spec_replicas{namespace=\"$namespace\", deployment=\"$app\"}",
          "legendFormat": "desired",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
